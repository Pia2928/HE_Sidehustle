# .env.example — copy to .env (never commit the real file)

# Long random string; required to download the CSV exports
ADMIN_TOKEN=change-me-to-a-long-random-string

# SQLite file. On Azure App Service use a path under /home so it persists.
DB_PATH=/home/data/study.db

# Option 0: Anthropic (Claude). If set, this is used.
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-sonnet-5-5

# Option A: Azure OpenAI (recommended: UK South or an EU region)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
MODEL=<your-deployment-name>

# Option B: OpenAI directly (leave Azure values empty)
# OPENAI_API_KEY=
# MODEL=gpt-4o

# Leave all keys empty to run in mock mode for local testing.

TEMPERATURE=0.7
MAX_OUTPUT_TOKENS=500
MAX_USER_MESSAGES=40
MAX_MESSAGE_CHARS=1500

# --- Randomisation and main flow ---
# Fix the seed before launch and never change it afterwards (it defines the allocation sequence).
ALLOCATION_SEED=choose-a-secret-seed-and-record-it
ALLOCATION_SLOTS=2000
# Length of the brainstorm in seconds (same for all conditions). Continue unlocks when it ends.
IDEATION_SECONDS=300
# Where participants go after choosing their idea (your survey). Placeholders:
# {pid} {cond} {idea} {description} {study_id} {session_id}
SURVEY_URL=https://your-survey-link/?PROLIFIC_PID={pid}&cond={cond}&idea={idea}
# Testing only: allows /start?pid=TEST&cond=generic_ai. Must be off in the real study.
ALLOW_FORCED_CONDITION=0

# Sites allowed to embed the pages (CSP frame-ancestors). Check the domain
# your Gorilla participants actually see and adjust if needed.
FRAME_ANCESTORS='self' https://*.gorilla.sc https://gorilla.sc https://*.research.sc https://research.sc

# Start command (Azure Startup Command):
# gunicorn -k gthread -w 2 --threads 8 --timeout 120 -b 0.0.0.0:8000 app:app
